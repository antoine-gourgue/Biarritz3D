# ------------------------------------------------------------------
# Copie ce fichier en `.env` et renseigne les valeurs. `.env` est gitignoré.
# La carte 3D n'a besoin d'aucune clé : les données OpenStreetMap sont
# pré-générées dans public/data/biarritz.json (npm run data:fetch).
# ------------------------------------------------------------------

# Chaîne de connexion PostgreSQL (correspond à docker-compose.yml en local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biarritz3d?schema=public"
