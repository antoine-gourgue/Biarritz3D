# ------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.yml for local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/biarritz3d?schema=public"

# Google Maps Platform — Map Tiles API key for the Photorealistic 3D Tiles.
# Create one in Google Cloud Console (enable "Map Tiles API"), then RESTRICT it
# by HTTP referrer. It is exposed to the browser (NEXT_PUBLIC_), so restricting
# the key to your domains is essential.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
